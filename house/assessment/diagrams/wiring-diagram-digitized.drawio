        <!-- Legend -->
        <mxCell id="legend" value="Legend (from original diagram, transcribed with medium confidence -- see circuit-inventory.md)&#10;1: Garage&#10;2: Garage&#10;3: Hall, closet &amp; outlet&#10;4: Living Room&#10;5: Finished Room, outlet&#10;6: Kitchen&#10;7: Bedroom (which one illegible)&#10;8: Bath&#10;9: Dishwasher / washer&#10;10+: illegible in photo -- re-photograph original straight-on to transcribe" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="750" y="100" width="300" height="260" as="geometry" />
