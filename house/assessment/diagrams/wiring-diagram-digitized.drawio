<mxfile host="app.diagrams.net">
  <diagram name="Wiring Diagram (digitized draft)" id="wiring-draft-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="note" value="DRAFT digitization of the original hand-drawn diagram (see ../photos/2026-07-31-original-wiring-diagram.PNG).&#10;Room positions are approximate, NOT traced to scale or exact wall placement -- redraw/adjust against the photo as you verify each room.&#10;Circuit numbers 1-9 are transcribed from the legend with medium confidence; 10+ were not legible in the photo." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#990000;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="60" as="geometry" />
        </mxCell>

        <!-- Rooms (approximate relative layout, loosely matching the photo's L-shape) -->
        <mxCell id="room_garage" value="Garage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="160" height="120" as="geometry" />
        </mxCell>
        <mxCell id="room_hall" value="Hall" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="200" y="100" width="100" height="120" as="geometry" />
        </mxCell>
        <mxCell id="room_livingroom" value="Living Room" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="180" height="180" as="geometry" />
        </mxCell>
        <mxCell id="room_finished" value="Finished Room" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="160" height="140" as="geometry" />
        </mxCell>
        <mxCell id="room_kitchen" value="Kitchen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="480" y="240" width="160" height="120" as="geometry" />
        </mxCell>
        <mxCell id="room_bath" value="Bath (GFI noted on original)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f2ff;" vertex="1" parent="1">
          <mxGeometry x="300" y="280" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="room_br1" value="BR #1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="room_br2" value="BR #2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="room_util" value="Dishwasher / Washer area" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="520" y="400" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- Circuit markers 1-9, legend-mapped with medium confidence -->
        <mxCell id="c1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="90" y="150" width="30" height="30" as="geometry" />
